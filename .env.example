# Backend Environment Configuration
# Copy this file to .env and fill in your values

# === DATABASE ===
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/majority-hair

# === JWT & AUTHENTICATION ===
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRY=7d

# === STRIPE PAYMENT ===
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
# Obtain from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# === SHOPIFY WEBHOOK ===
# Obtain from Shopify Admin → Settings → Notifications → Webhooks → your endpoint → Signing secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
# Points awarded per dollar spent on a Shopify order (default: 100)
SHOPIFY_POINTS_PER_DOLLAR=100

# === SHOPIFY STOREFRONT (wholesale catalog) ===
# Shopify Admin → Settings → Apps and sales channels → Develop apps → create an app → Configuration →
# Storefront API scopes: unauthenticated_read_product_listings + unauthenticated_read_product_inventory →
# install → copy the Storefront API access token. Wholesale products must be available to that app's sales channel.
SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_access_token
SHOPIFY_STORE_DOMAIN=c0bqfe-z2.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2025-07

# === EMAIL (Gmail SMTP) ===
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# === OAUTH PROVIDERS ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# === FILE STORAGE ===
# AWS S3 OR CLOUDINARY
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=majority-hair-media

CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

CDN_URL=https://cdn.majority-hair.com

# === SERVER ===
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.com
